{
  "name": "@vaultx/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:verify:generator": "tsx src/generator/verify-generator-tables.ts",
    "generator:quality-samples": "tsx src/generator/run-quality-samples.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "prisma": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
