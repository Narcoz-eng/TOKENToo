{
  "name": "vaultx",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "postinstall": "npm run db:generate",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm --workspace frontend run build && npm --workspace backend run build",
    "typecheck": "npm --workspace frontend run typecheck && npm --workspace backend run typecheck",
    "test:api-errors": "tsx frontend/lib/api-error-handling.test.ts",
    "test:api-regression": "tsx backend/src/env/startup-validation.test.ts && tsx backend/src/system/api-route-regression.test.ts && tsx scripts/api-proxy-regression.test.ts",
    "db:generate": "npm --workspace backend run db:generate",
    "db:migrate:deploy": "npm --workspace backend run db:migrate:deploy",
    "db:verify:generator": "npm --workspace backend run db:verify:generator",
    "audit:production": "npm --workspace backend run audit:production",
    "db:push": "npm --workspace backend run db:push",
    "assets": "powershell -ExecutionPolicy Bypass -File scripts/generate-assets.ps1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
