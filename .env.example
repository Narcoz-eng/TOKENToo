# VaultX environment
# Supported modes:
# 1. Manual Supabase mode: set DATABASE_URL and DIRECT_URL yourself.
# 2. Vercel Supabase integration mode: Vercel injects POSTGRES_* and SUPABASE_* vars.

# ---------------------------------------------------------------------------
# Mode 1: Manual Supabase mode
# ---------------------------------------------------------------------------
# Runtime should use Supabase/Supavisor transaction pooling for Vercel/serverless.
DATABASE_URL="postgresql://postgres.etmrgphkomagszfezsxf:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Prisma migrations should use a direct or non-pooling connection.
DIRECT_URL="postgresql://postgres.etmrgphkomagszfezsxf:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Mode 2: Vercel Supabase integration mode
# ---------------------------------------------------------------------------
# Vercel provides these automatically when the Supabase integration is connected.
# Prisma runtime mapping: DATABASE_URL = POSTGRES_PRISMA_URL
# Prisma migration mapping: DIRECT_URL = POSTGRES_URL_NON_POOLING
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL="https://etmrgphkomagszfezsxf.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_CBv8Gmyx9g3Lrl9LLk_6vg_G6Qg6KPV"
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL="https://etmrgphkomagszfezsxf.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_CBv8Gmyx9g3Lrl9LLk_6vg_G6Qg6KPV"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_CBv8Gmyx9g3Lrl9LLk_6vg_G6Qg6KPV"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
FRONTEND_ORIGIN="http://localhost:3000"
NODE_ENV=development
APP_ENV=development
ENABLE_MOCK_MINT=false
ENABLE_PRODUCTION_MINT=false

# ---------------------------------------------------------------------------
# Generator
# ---------------------------------------------------------------------------
GENERATOR_SEED_SALT="vaultx-local-seed-change-me"
GENERATOR_DEFAULT_PRESET="mystic-pixel-cult"
WALLET_AUTH_SECRET="change-me-for-vercel"
API_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Asset providers
# ---------------------------------------------------------------------------
DESIGN_MODEL_PROVIDER=mock
LAYER_PACK_PROVIDER=mock
LEGENDARY_ASSET_PROVIDER=mock
ASSET_STORAGE_PROVIDER=mock
FINAL_ASSET_STORAGE_PROVIDER=pinata
METAPLEX_NFT_STANDARD=METAPLEX_CORE
NFT_STANDARD=metaplex_core
SOLANA_TRANSACTION_PROVIDER=devnet
SOLANA_RPC_URL="https://api.devnet.solana.com"
PROGRAM_ID=
ANCHOR_PROVIDER_URL="https://api.devnet.solana.com"
ANCHOR_WALLET=

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
HELIUS_API_KEY=
TRITON_RPC_URL=

# ---------------------------------------------------------------------------
# Storage / future NFT publishing
# ---------------------------------------------------------------------------
ARWEAVE_WALLET_PATH=
NFT_STORAGE_TOKEN=
PINATA_JWT=
IRYS_PRIVATE_KEY=
IPFS_GATEWAY_URL="https://ipfs.io/ipfs/"
DEVNET_TEST_TOKEN_MINT=
DEVNET_TEST_WALLET_PUBLIC_KEY=
DEVNET_TEST_COLLECTION_ASSET=
