# Shared
NODE_ENV=development

# Solana
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_API_KEY=
TRITON_RPC_URL=

# Supabase + Prisma
# Runtime should use Supavisor transaction pooling for serverless/high concurrency.
DATABASE_URL="postgresql://prisma.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI should use a direct/session connection.
DIRECT_URL="postgresql://prisma.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Storage
ARWEAVE_WALLET_PATH=
NFT_STORAGE_TOKEN=
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

