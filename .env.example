# Phew.run environment template
# Copy to .env.local and fill values locally. Do not commit .env.local.

# ---------------------------------------------------------------------------
# Supabase + Prisma
# ---------------------------------------------------------------------------
# Get connection strings from Supabase Dashboard -> Connect.
# Runtime Prisma Client should use DATABASE_URL.
# Prisma CLI/migrations should use DIRECT_URL.
# Supabase/Neon URLs must include sslmode=require. Prisma runtime normalizes
# Supabase-style URLs to libpq-compatible TLS semantics. Do not set
# DATABASE_SSL_NO_VERIFY unless you are connecting to a trusted private
# self-signed Postgres endpoint.
# If direct IPv6 is unavailable locally, use the Supabase session pooler.
# Avoid transaction pooler for Prisma migrations/prepared-statement workflows
# unless the code and connection string are explicitly configured for it.
DATABASE_URL="postgresql://...?sslmode=require"
DIRECT_URL="postgresql://...?sslmode=require"
DATABASE_SSL_NO_VERIFY=false

# Optional Vercel/Supabase integration aliases.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ---------------------------------------------------------------------------
# Supabase API keys
# ---------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
FRONTEND_ORIGIN="http://localhost:3000"
NODE_ENV=development
APP_ENV=development
APP_MODE=founder
SINGLE_USER_MODE=true
ENABLE_MOCK_MINT=false
ENABLE_PRODUCTION_MINT=false

# ---------------------------------------------------------------------------
# Generator
# ---------------------------------------------------------------------------
GENERATOR_SEED_SALT="change-me"
GENERATOR_DEFAULT_PRESET="mystic-pixel-cult"
WALLET_AUTH_SECRET="change-me"
API_RATE_LIMIT_PER_MINUTE=120
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
ENABLE_AI_IMAGE_GENERATION=false

# ---------------------------------------------------------------------------
# Asset providers
# ---------------------------------------------------------------------------
DESIGN_MODEL_PROVIDER=mock
LAYER_PACK_PROVIDER=mock
LEGENDARY_ASSET_PROVIDER=mock
ASSET_STORAGE_PROVIDER=mock
FINAL_ASSET_STORAGE_PROVIDER=pinata
FINAL_RENDER_STORAGE_ROOT=
FINAL_RENDERER_VERSION=v1
CURATED_LAYER_PACK_MANIFEST_URI=
CURATED_LAYER_PACK_ROOT=
APPROVED_LAYER_PACK_ID=
REQUIRED_LAUNCH_ASSET_STATUS=CURATED_LAYER_READY
ARTIST_APPROVED_ASSETS=false
FINAL_PRODUCTION_ASSETS_APPROVED=false
METAPLEX_NFT_STANDARD=METAPLEX_CORE
NFT_STANDARD=metaplex_core
SOLANA_TRANSACTION_PROVIDER=devnet
SOLANA_RPC_URL="https://api.devnet.solana.com"
PROGRAM_ID=8i9Xd9ikQSEdDstcV9L8ikru8nZFBsNWx2Y5TQpgAnU6
NEXT_PUBLIC_PROGRAM_ID=8i9Xd9ikQSEdDstcV9L8ikru8nZFBsNWx2Y5TQpgAnU6
ANCHOR_PROVIDER_URL="https://api.devnet.solana.com"
ANCHOR_WALLET=

# ---------------------------------------------------------------------------
# Solana devnet
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
HELIUS_API_KEY=
TRITON_RPC_URL=
DEVNET_TEST_WALLET_PUBLIC_KEY=
DEVNET_TEST_TOKEN_MINT=
DEVNET_TEST_COLLECTION_ASSET=

# ---------------------------------------------------------------------------
# Storage / future NFT publishing
# ---------------------------------------------------------------------------
ARWEAVE_WALLET_PATH=
NFT_STORAGE_TOKEN=
PINATA_JWT=
IRYS_PRIVATE_KEY=
IPFS_GATEWAY_URL="https://ipfs.io/ipfs/"
